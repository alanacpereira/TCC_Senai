
Options -Indexes
DirectoryIndex plataforma/index.php

# Redireciona a raiz para a plataforma
RewriteEngine On
RewriteRule ^$ plataforma/index.php [L]

# Keep database exports, local documents, backups, and environment files private.
<FilesMatch "(?i)(\.sql|\.sqlite|\.db|\.bak|\.backup|\.env|\.docx|\.md)$">
    Require all denied
</FilesMatch>

# Do not expose repository metadata or dotfiles through Apache.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
