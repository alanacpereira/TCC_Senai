
Options -Indexes
DirectoryIndex plataforma/index.php

RewriteEngine On

# Encaminha a raiz para a página inicial da plataforma
RewriteRule ^$ plataforma/index.php [L]

# Encaminha arquivos PHP para a pasta plataforma
# somente quando não existem na raiz e existem na plataforma
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/plataforma/$1 -f
RewriteRule ^([a-zA-Z0-9_-]+\.php)$ plataforma/$1 [L]

# Protege bancos de dados, backups, documentos e arquivos de ambiente
<FilesMatch "(?i)(\.sql|\.sqlite|\.db|\.bak|\.backup|\.env|\.docx|\.md)$">
    Require all denied
</FilesMatch>

# Bloqueia acesso a arquivos ocultos e metadados do repositório
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
